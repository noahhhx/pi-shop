+/** Find a live Pi process in a pane: its PID, or undefined when none matches. */
+export type PanePiProcessScan = (
+	shellPid: number,
+	cwd: string,
+) => number | undefined;
+
+/**
+ * Find a live `pi` process running in `cwd` as the pane shell's descendant.
+ * Herdr's foreground reports cannot see it there: a wrapper shell's jobs
+ * never join the pane's foreground process group (devenv's auto-enter
+ * wrapper), and Pi rewrites its command line, so neither the foreground
+ * process list nor argv matching can identify it. Process identity is
+ * immutable kernel facts instead: `comm`, the working directory, and the
+ * PID ancestry back to the pane shell.
+ */
+export function createLinuxPanePiProcessScan(
+	read: (path: string) => string = (path) => readFileSync(path, "utf8"),
+	list: (path: string) => string[] = (path) => readdirSync(path),
+	readlink: (path: string) => string = (path) => readlinkSync(path),
+): PanePiProcessScan {
+	return (shellPid, cwd) => {
+		if (process.platform !== "linux") return undefined;
+		let target: string;
+		try {
+			// Pi's /proc cwd is resolved; the requested checkout may not be.
+			target = realpathSync(cwd);
+		} catch {
+			target = cwd;
+		}
+		for (const entry of list("/proc")) {
+			if (!/^\d+$/.test(entry)) continue;
+			const pid = Number(entry);
+			try {
+				if (read(`/proc/${pid}/comm`).trimEnd() !== "pi") continue;
+				if (readlink(`/proc/${pid}/cwd`) !== target) continue;
+				let cursor = pid;
+				for (let depth = 0; depth < MAX_ANCESTRY_DEPTH; depth++) {
+					if (cursor === shellPid) return pid;
+					const stat = parseProcessStat(read(`/proc/${cursor}/stat`));
+					if (stat.ppid <= 0) break;
+					cursor = stat.ppid;
+				}
+			} catch {
+				// Processes come and go while scanning; unreadable facts skip a PID.
+				continue;
+			}
+		}
+		return undefined;
+	};
+}
+
+export const linuxPanePiProcessScan = createLinuxPanePiProcessScan();

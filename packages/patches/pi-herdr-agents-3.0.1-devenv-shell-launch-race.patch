+/** Best-effort screen tail for launch diagnostics; never delays the failure. */
+async function readSurfaceScreenTail(
+	provider: SurfaceProvider,
+	surface: string,
+): Promise<string> {
+	try {
+		const screen = await Promise.race([
+			Promise.resolve(provider.readScreen(surface, 12)),
+			new Promise<string | undefined>((resolve) => {
+				const timer = setTimeout(() => resolve(undefined), 1_000);
+				timer.unref?.();
+			}),
+		]);
+		if (screen === undefined) return "";
+		const tail = screen
+			.trimEnd()
+			.split("\n")
+			.filter((line) => line.trim().length > 0)
+			.slice(-3)
+			.join(" | ");
+		return tail ? ` Screen tail: ${tail}` : "";
+	} catch {
+		return "";
+	}
